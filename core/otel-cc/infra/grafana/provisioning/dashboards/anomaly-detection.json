          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(increase(cc_cost_usd_total[1h])[3d:1h]) + 2 * stddev_over_time(increase(cc_cost_usd_total[1h])[3d:1h])",
          "legendFormat": "+2σ Threshold"
        }
      ]
